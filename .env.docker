# ============================================
# Variáveis de ambiente para docker-compose
# Copie este arquivo para .env antes de subir
# ============================================

# Senha do banco PostgreSQL
DB_PASSWORD=SuaSenhaForteAqui123!

# Senha URL-encoded (se tiver @, #, etc: @ → %40, # → %23)
DB_PASSWORD_URL_ENCODED=SuaSenhaForteAqui123!

# Segredo JWT (gere com: openssl rand -base64 64)
JWT_SECRET=troque-este-segredo-com-openssl-rand

# --- Domínio público (produção) ---
# Use https:// sem barra final. Depois de alterar VITE_API_URL, rode:
#   docker compose build --no-cache frontend
FRONTEND_URL=https://pbonelocker.com.br
API_URL=https://pbonelocker.com.br/api
VITE_API_URL=https://pbonelocker.com.br/api

# Bind da porta do frontend no host (padrão: só loopback, para o Nginx do servidor)
# Para testar sem proxy no host: HOST_BIND_FRONTEND=0.0.0.0
HOST_BIND_FRONTEND=127.0.0.1

# Opcional: mais origens no CORS, separadas por vírgula
# CORS_ORIGENS_ADICIONAIS=https://www.pbonelocker.com.br
